+def test_native_nba_v2_interrupted_root_never_allows_a_new_search(native_nba_v2, tmp_path, attempt_failure):
+    target, app, head = native_nba_v2
+    root = Path(target[0])
+    pointer, barrier, trace = (tmp_path / name for name in ('pointer.json', 'first-trial', 'observed.json'))
+    _native_nba_v2_command(target, pointer, register=True)
+    facts = _native_nba_v2_registration_readback(root, head, pointer)
+    with _process('nba-v2-cli', target, pointer=str(pointer), barrier_after_trial=1,
+                  barrier=str(barrier), trace=str(trace), fail_validation=attempt_failure,
+                  stop_after=1) as first:
+        _wait_path(barrier, first, timeout=60)
+        started, = _native_nba_v2_run_events(app, facts.plan.run_key)
+        assert started[1:3] == ('STARTED', 1)
+        failed_attempt_id = None
+        if attempt_failure:
+            barrier.with_suffix('.release').touch()
+            failed = _reply(first, 1, timeout=120)
+            assert failed['error_code'] == 'papersim_optimize_transport_failure'
+            assert failed['details']['stage'] == 'validate_result'
+            failed_attempt_id = failed['details']['attempt_event_id']
+            assert failed_attempt_id is not None
+        else:
+            first.kill()
+            first.communicate(timeout=10)
+    adapter = _adapter()
+    lock = adapter._OPERATION_NAMESPACE, adapter._advisory_lock_number(facts.plan.run_key)
+    end = time.monotonic() + 15
+    while not app.execute('SELECT pg_try_advisory_lock(%s, %s)', lock).fetchone()[0]:
+        assert time.monotonic() < end
+        time.sleep(0.02)
+    assert app.execute('SELECT pg_advisory_unlock(%s, %s)', lock).fetchone() == (True,)
+    trial = facts.plan.trials[0]
+    assert json.loads(trace.read_bytes()) == [[trial.fold_sha256, trial.spec_sha256, trial.model_context,
+                                             list(trial.targets)]]
+    before = _counts(app)
+    events = _native_nba_v2_run_events(app, facts.plan.run_key)
+    if attempt_failure:
+        assert [event[:3] for event in events] == [started[:3], (failed_attempt_id, 'FAILED', 1)]
+        assert events[1][6][0]['original_started_event_id'] == started[0]
+        assert events[1][7][0]['witnessed'] is None
+    else:
+        assert events == [started]
+    for attempt in (1, 2):
+        refusal = _native_nba_v2_command(target, pointer, code=1, forbid_compute=True, attempt=attempt)
+        assert refusal['error_code'] == 'papersim_optimize_nba_odr_interrupted' and refusal['calls'] == []
+        assert refusal['details']['started_event_id'] == started[0]
+        assert refusal['details']['attempt_event_id'] == failed_attempt_id
+    _native_nba_v2_preview(target, app, pointer, facts, 'interrupted', started_event_id=started[0],
+                           terminal_event_id=None, attempt_event_id=failed_attempt_id)
+    assert _counts(app) == before and _native_nba_v2_run_events(app, facts.plan.run_key) == events
