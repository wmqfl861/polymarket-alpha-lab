+@dataclass(frozen=True, slots=True, kw_only=True)
+class NBAArchiveEvent:
+    """Verified event identity, source clocks, teams, and schedule context."""
+
+    season: str
+    event_id: str
+    season_source_sha256: str
+    source_day: date
+    label_day: date
+    started: datetime
