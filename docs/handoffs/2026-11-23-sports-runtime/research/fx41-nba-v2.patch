+@pytest.mark.parametrize("expired_at_entry", [False, True])
+def test_odr_claimed_budget_retains_full_plan_on_expiry(odr_claim_inputs, odr_scoring_archives, monkeypatch,
+                                                       expired_at_entry):
+    inputs, claim_type = odr_claim_inputs
+    callbacks = []
+
+    def fake_evaluator(family, lines, deadline):
+        def evaluate(spec, fold, targets):
+            callbacks.append((fold.block_id, spec.spec_sha256(), targets))
+            return {
+                target: HoldoutEvaluation((), refusals=tuple(
+                    Refusal(row.event_key, row.line_key, "synthetic_refusal") for row in lines
+                    if row.target == target and row.event_key in fold.test_keys
+                ))
+                for target in targets
+            }
+
+        return evaluate
+
+    monkeypatch.setattr(runner, "_nba_family_evaluator", fake_evaluator)
+    if expired_at_entry:
+        def unopened(*args):
+            pytest.fail("a deadline at entry opened the scoring source")
+
+        monkeypatch.setattr(nba_odr, "load_nba_odr_archives", unopened)
+    claim = claim_type(replace(inputs, deadline=lambda: expired_at_entry or bool(callbacks)))
+    result = runner._execute_claimed_nba_odr(claim)
+    artifact = json.loads(result.artifact_bytes)
+    counts = artifact["counts"]
+    started = 0 if expired_at_entry else 1
+    assert result.outcome == runner.RUN_FAILED and result.budget_exhausted
+    assert result.submission.budget["max_trials"] == 4_811
+    assert len(artifact["planned_evaluations"]) == counts["planned_trials"] == 4_811
+    assert counts["target_uses_planned"] == 9_622 and counts["shared_target_uses_planned"] == 4_811
+    assert result.submission.trial_count == len(callbacks) == counts["started_trials"] == started
+    assert counts["empty_trials"] == started and counts["target_uses_started"] == 2 * started
+    assert counts["unexecuted_trials"] == 4_811 - started
+    assert len(artifact["search_group_ids"]) == 289 and len(artifact["holdout"]["planned_folds"]) == 38
+    assert artifact["holdout"]["n_events"] == 304 and artifact["holdout"]["callbacks"] == []
+    assert artifact["nba_odr_registration"]["started_event_id"] == 11
+    assert artifact["failure"] == {"step": runner.PHASE_LOAD if expired_at_entry else runner.PHASE_WALK_FORWARD,
+                                   "reason": "compute_deadline"}
+    with pytest.raises(ValueError, match="claim already consumed"):
+        runner._execute_claimed_nba_odr(claim)
