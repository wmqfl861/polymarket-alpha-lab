127: def _public_builders(module: Any) -> tuple[Any, ...]:
128:     return tuple(
129:         value
130:         for name, value in vars(module).items()
131:         if name.startswith("build_") and inspect.isfunction(value) and value.__module__ == module.__name__
132:     )
133: 
134: 
135: def _public_dataclasses(module: Any) -> tuple[type[Any], ...]:
136:     return tuple(
137:         value
138:         for name, value in vars(module).items()
139:         if not name.startswith("_")
140:         and isinstance(value, type)
141:         and is_dataclass(value)
142:         and value.__module__ == module.__name__
143:     )
144: 
145: 
146: def _has_all_flag_fields(data_class: type[Any]) -> bool:
147:     field_names = {field.name for field in fields(data_class)}
148:     return {"paper_only", "report_only", "readonly"}.issubset(field_names)
149: 
150: 
151: def _forbidden_import_roots(tree: ast.AST) -> set[str]:
152:     roots: set[str] = set()
153:     for node in ast.walk(tree):
154:         if isinstance(node, ast.Import):
155:             roots.update(alias.name.split(".", maxsplit=1)[0] for alias in node.names)
156:         elif isinstance(node, ast.ImportFrom) and node.module is not None:
157:             roots.add(node.module.split(".", maxsplit=1)[0])
158:     return roots
159: 
160: 
161: def _top_level_call_names(tree: ast.Module) -> set[str]:
162:     names: set[str] = set()
163:     for node in tree.body:
164:         if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
165:             continue
166:         for child in ast.walk(node):
167:             if isinstance(child, ast.Call):
168:                 if isinstance(child.func, ast.Name):
169:                     names.add(child.func.id)
170:                 elif isinstance(child.func, ast.Attribute):
171:                     names.add(child.func.attr)
172:     return names

