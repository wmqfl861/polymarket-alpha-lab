124: def _module_path(module_name: str) -> Path:
125:     return PACKAGE_ROOT / f"{module_name}.py"
126: 
127: 
128: def _require_module_path(module_name: str) -> Path:
129:     path = _module_path(module_name)
130:     if not path.exists():
131:         pytest.fail(
132:             "Expected Phase 1 team diagnostics module at "
133:             f"src/polymarket_alpha_lab/{module_name}.py",
134:         )
135:     return path
136: 
137: 
138: def _require_import(module_name: str) -> object:
139:     import_name = f"polymarket_alpha_lab.{module_name}"
140:     try:
141:         return importlib.import_module(import_name)
142:     except ModuleNotFoundError as exc:
143:         raise AssertionError(
144:             f"Expected importable Phase 1 team diagnostics API at {import_name}",
145:         ) from exc
146: 
147: 
148: def _parse_module(path: Path) -> ast.Module:
149:     return ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
150: 
151: 
152: def _literal_all(tree: ast.Module, *, module_name: str) -> tuple[str, ...]:
153:     for node in tree.body:
154:         if isinstance(node, ast.Assign) and any(
155:             isinstance(target, ast.Name) and target.id == "__all__"
156:             for target in node.targets
157:         ):
158:             value = ast.literal_eval(node.value)
159:             return tuple(value)
160:     pytest.fail(f"__all__ assignment not found in {module_name}.py")
161: 
162: 
163: def _imported_modules(tree: ast.AST) -> tuple[str, ...]:
164:     modules: list[str] = []
165:     for node in ast.walk(tree):
166:         if isinstance(node, ast.Import):
167:             modules.extend(alias.name for alias in node.names)
168:             modules.extend(alias.asname for alias in node.names if alias.asname)
169:         elif isinstance(node, ast.ImportFrom) and node.module is not None:
170:             modules.append(node.module)
171:             modules.extend(alias.asname for alias in node.names if alias.asname)
172:     return tuple(modules)
173: 
174: 
175: def _identifier_names(tree: ast.AST) -> tuple[str, ...]:
176:     names: list[str] = []
177:     for node in ast.walk(tree):
178:         if isinstance(node, ast.FunctionDef | ast.AsyncFunctionDef | ast.ClassDef):
179:             names.append(node.name)
180:         elif isinstance(node, ast.Name):
181:             names.append(node.id)
182:         elif isinstance(node, ast.Attribute):
183:             names.append(node.attr)
184:         elif isinstance(node, ast.arg):
185:             names.append(node.arg)
186:         elif isinstance(node, ast.keyword) and node.arg is not None:
187:             names.append(node.arg)
188:         elif isinstance(node, ast.alias):
189:             names.append(node.name.rsplit(".", 1)[-1])
190:             if node.asname is not None:
191:                 names.append(node.asname)
192:     return tuple(names)
193: 
194: 
195: def _call_names(tree: ast.AST) -> tuple[str, ...]:
196:     names: list[str] = []
197:     for node in ast.walk(tree):
198:         if not isinstance(node, ast.Call):
199:             continue
200:         if isinstance(node.func, ast.Name):
201:             names.append(node.func.id)
202:         elif isinstance(node.func, ast.Attribute):
203:             names.append(node.func.attr)
204:     return tuple(names)
205: 
206: 
207: def _normal_identifier(value: str) -> str:
208:     return "".join(character for character in value.lower() if character.isalnum())
209: 
210: 
211: def _matches_module_prefix(module_name: str, prefix: str) -> bool:
212:     return module_name == prefix or module_name.startswith(f"{prefix}.")
213: 
214: 
215: def _exported_names(module: object, *, module_name: str) -> tuple[str, ...]:
216:     exports = getattr(module, "__all__", None)
217:     if exports is None:
218:         pytest.fail(f"{module_name} must define __all__")
219:     return tuple(exports)
220: 
