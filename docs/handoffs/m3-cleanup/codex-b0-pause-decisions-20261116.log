143: def _block_import_time_io(monkeypatch: pytest.MonkeyPatch) -> None:
144:     original_import = builtins.__import__
145: 
146:     def guarded_open(*args: object, **kwargs: object) -> Any:
147:         raise _ImportIoBlocked(f"import attempted file open: {args!r} {kwargs!r}")
148: 
149:     def guarded_connect(*args: object, **kwargs: object) -> Any:
150:         raise _ImportIoBlocked(f"import attempted socket connection: {args!r} {kwargs!r}")
151: 
152:     def guarded_create_connection(*args: object, **kwargs: object) -> Any:
153:         raise _ImportIoBlocked(
154:             f"import attempted network connection: {args!r} {kwargs!r}",
155:         )
156: 
157:     def guarded_import(
158:         name: str,
159:         globals: dict[str, object] | None = None,
160:         locals: dict[str, object] | None = None,
161:         fromlist: tuple[str, ...] = (),
162:         level: int = 0,
163:     ) -> Any:
164:         if name == "psycopg" or name.startswith("psycopg."):
165:             raise _ImportIoBlocked(f"import attempted database adapter load: {name}")
166:         return original_import(name, globals, locals, fromlist, level)
167: 
168:     monkeypatch.setattr(builtins, "open", guarded_open)
169:     monkeypatch.setattr(Path, "open", guarded_open)
170:     monkeypatch.setattr(Path, "read_text", guarded_open)
171:     monkeypatch.setattr(Path, "read_bytes", guarded_open)
172:     monkeypatch.setattr(socket.socket, "connect", guarded_connect, raising=False)
173:     monkeypatch.setattr(socket.socket, "connect_ex", guarded_connect, raising=False)
174:     monkeypatch.setattr(socket, "create_connection", guarded_create_connection)
175:     monkeypatch.setattr(builtins, "__import__", guarded_import)
176: 
177: 
178: def _public_module_dataclasses(module: ModuleType) -> tuple[tuple[str, type[object]], ...]:
179:     return tuple(
180:         (name, value)
181:         for name, value in sorted(vars(module).items())
182:         if not name.startswith("_")
183:         and inspect.isclass(value)
184:         and value.__module__ == module.__name__
185:         and dataclasses.is_dataclass(value)
186:     )
187: 
188: 
189: def _has_phase1_flag_fields(value: type[object]) -> bool:
190:     return set(PHASE1_FLAG_FIELDS).issubset(_field_defaults(value))
191: 
192: 
193: def _field_defaults(value: type[object]) -> dict[str, object]:
194:     return {field.name: field.default for field in dataclasses.fields(value)}

