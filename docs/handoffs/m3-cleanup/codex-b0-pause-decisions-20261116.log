152: IDENTIFIER_TOKEN_RE = re.compile(
153:     r"[A-Z]+(?=[A-Z][a-z]|\d|$)|[A-Z]?[a-z]+|\d+",
154: )
155: 
156: 
157: def module_path(module_name: str) -> Path:
158:     return REPO_ROOT / "src" / PACKAGE_ROOT / f"{module_name}.py"
159: 
160: 
161: def parse_module(module_name: str) -> ast.Module:
162:     path = module_path(module_name)
163:     assert path.exists(), (
164:         f"{module_name} integration module must exist at {path} before this "
165:         "boundary test can pass"
166:     )
167:     return ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
168: 
169: 
170: def import_integration_module(module_name: str) -> ModuleType:
171:     full_name = f"{PACKAGE_ROOT}.{module_name}"
172:     try:
173:         return importlib.import_module(full_name)
174:     except ModuleNotFoundError as exc:
175:         if exc.name == full_name:
176:             pytest.fail(f"{full_name} must be importable for integration boundary tests")
177:         pytest.fail(f"{full_name} imports missing dependency {exc.name!r}")
178: 
179: 
180: def module_matches_prefix(module_name: str, prefix: str) -> bool:
181:     return module_name == prefix or module_name.startswith(f"{prefix}.")
182: 
183: 
184: def absolute_import_from_module(node: ast.ImportFrom) -> str:
185:     if node.level == 0:
186:         return node.module or ""
187:     assert node.level == 1, ast.unparse(node)
188:     if node.module is None:
189:         return PACKAGE_ROOT
190:     return f"{PACKAGE_ROOT}.{node.module}"
191: 
192: 
193: def imported_modules(tree: ast.Module) -> tuple[str, ...]:
194:     modules: list[str] = []
195:     for node in ast.walk(tree):
196:         if isinstance(node, ast.Import):
197:             modules.extend(alias.name for alias in node.names)
198:         elif isinstance(node, ast.ImportFrom):
199:             modules.append(absolute_import_from_module(node))
200:     return tuple(modules)
201: 
202: 
203: def identifier_tokens(identifier: str) -> tuple[str, ...]:
204:     tokens: list[str] = []
205:     for chunk in re.split(r"[^0-9A-Za-z]+", identifier):
206:         if not chunk:
207:             continue
208:         tokens.extend(match.group(0).lower() for match in IDENTIFIER_TOKEN_RE.finditer(chunk))
209:     return tuple(tokens)
