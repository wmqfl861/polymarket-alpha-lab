[Unit]
Description=Schedule pre-match football reminders and wake available workers
Requires=pal-football-notify-pg.service
After=pal-football-notify-pg.service

[Service]
Type=oneshot
UMask=0077
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=%h/.config/pal-sports-paper/runtime.env
WorkingDirectory=@PAL_WORKING_DIR@
ExecStart="@PAL_PYTHON@" -B "@PAL_RUNTIME_ROOT@/scripts/football_daily.py" tick
TimeoutStartSec=50s
KillMode=control-group
NoNewPrivileges=yes
