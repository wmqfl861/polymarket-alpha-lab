164: def test_settlement_pnl_gross_conserves_resolutions_exactly(
165:     importer, plan
166: ):
167:     snapshot = importer.load_snapshot(SNAPSHOT_DIR)
168:     legacy_total = sum((row["pnl"] for row in snapshot.resolutions),
169:                        Decimal("0.00"))
170:     imported_total = sum((row.pnl_gross for row in plan.settlements),
171:                          Decimal("0.00"))
172:     assert imported_total == legacy_total == Decimal("3768.33")
173:     # Per-market conservation: every resolved, allocatable market keeps its
174:     # recorded market-level pnl exactly.
175:     per_market: dict[str, Decimal] = {}
176:     for row in plan.settlements:
177:         per_market[row.market_id] = per_market.get(
178:             row.market_id, Decimal("0.00")) + row.pnl_gross
179:     for resolution in snapshot.resolutions:
180:         if resolution["market_id"] in per_market:
181:             assert per_market[resolution["market_id"]] == resolution["pnl"]
