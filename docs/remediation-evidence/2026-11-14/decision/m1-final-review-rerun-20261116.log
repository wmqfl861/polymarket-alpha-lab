333:                        "pnl_net", "confirmed_at"]
334:             return [tuple(row.get(name) for name in columns) for row in self._candidates], columns
335:         if sql.startswith("SELECT candidate_id, evidence_role"):
336:             columns = ["candidate_id", "evidence_role", "model_probability", "mid",
337:                        "bid", "ask", "last"]
338:             return [tuple(row[name] for name in columns) for row in self._evidence], columns
