1159:         c for c in candidates if c.accepted and c.stake is not None
1160:     ]
1161:     counted = [c for c in entered if c.outcome in _COUNTED_OUTCOMES]
1162:     exited = [c for c in entered if c.outcome == ledger.EXITED_OUTCOME]
1163:     counts = QueueCounts(
1164:         candidates=len(candidates),
1165:         accepted=sum(1 for c in candidates if c.accepted),
1166:         rejected=sum(1 for c in candidates if not c.accepted),
1167:         entered=len(entered),
1168:         settled=len(counted),
1169:         exited=len(exited),
1170:         unresolved=sum(1 for c in candidates if c.outcome is None),
1171:         voided=sum(1 for c in candidates if c.outcome == ledger.VOIDED_OUTCOME),
1172:     )
1173:     roi, roi_rows = _roi_metrics(counted, pnl_basis)
1174: 
1175:     natural = [c for c in entered if c.outcome in ledger.NATURAL_OUTCOMES]
1176:     hits = sum(
1177:         1 for c in natural if natural_hit(str(c.side), str(c.outcome))
1178:     )
1179:     fills = FillMetrics(
1180:         natural_settled=len(natural),
1181:         hits=hits,
1182:         hit_rate=(hits / len(natural)) if natural else None,
1183:         avg_fill_price=(
1184:             sum(float(c.fill_price) for c in counted) / len(counted)
1185:             if counted else None
1186:         ),
1187:         status=STATUS_OK if counted else STATUS_INSUFFICIENT,
1188:     )
1189: 
1190:     with_close = [
1191:         c for c in entered
1192:         if c.close_price is not None and c.fill_price is not None
1193:     ]
1194:     clv_values = [float(c.close_price) - float(c.fill_price) for c in with_close]
1195:     if with_close:
1196:         clv_clusters = [
1197:             [float(c.close_price) - float(c.fill_price) for c in group]
1198:             for group in cluster_rows(with_close)
1199:         ]
1200:         clv_ci = _bootstrap_mean_ci(clv_clusters)
1201:         clv_mean = sum(clv_values) / len(clv_values)
1202:         clv_status = STATUS_OK
1203:     else:
1204:         clv_ci = (None, None)
1205:         clv_mean = None
1206:         clv_status = STATUS_INSUFFICIENT
1207:     clv = ClvMetrics(
1208:         entries_eligible=len(entered),
1209:         entries_with_close=len(with_close),
1210:         mean=clv_mean,
1232:     by_market: dict[str, list[_RoiRow]] = {}
1233:     for row in roi_rows:
1234:         by_market.setdefault(row.candidate.market_key, []).append(row)
1235:     # Gross concentration stays the historical-report block (the 10-30
1236:     # anchors: 51.1% top-market share). The OD-G criterion E verdict
1237:     # reads the net-of-fees concentration (M1 final review P2-02): the
1238:     # most profitable market by net PnL over the queue's total net PnL.
1239:     total_pnl = sum(row.gross for row in roi_rows)
1240:     if by_market and total_pnl > 0:
1241:         top_key = max(
1242:             by_market,
1243:             key=lambda market: sum(row.gross for row in by_market[market]),
1244:         )
1245:         top_pnl = sum(row.gross for row in by_market[top_key])
1246:         share = top_pnl / total_pnl
1247:         concentration_status = STATUS_OK
1248:     else:
1249:         top_key = None
1250:         top_pnl = None
1251:         share = None
1252:         concentration_status = (
1253:             STATUS_UNDEFINED if roi_rows else STATUS_INSUFFICIENT
1254:         )
1255:     net_total_pnl = sum(row.net for row in roi_rows)
1256:     if by_market and net_total_pnl > 0:
1257:         net_top_key = max(
1258:             by_market,
1259:             key=lambda market: sum(row.net for row in by_market[market]),
1260:         )
1261:         net_top_pnl = sum(row.net for row in by_market[net_top_key])
1262:         net_share = net_top_pnl / net_total_pnl
1263:     else:
1264:         net_top_key = None
1265:         net_top_pnl = None
1266:         net_share = None
1267:     concentration = ConcentrationMetrics(
1268:         total_pnl=total_pnl,
1269:         top_market_key=top_key,
1270:         top_market_pnl=top_pnl,
1271:         top_market_share=share,
1272:         net_total_pnl=net_total_pnl,
1273:         top_market_net_key=net_top_key,
1274:         top_market_net_pnl=net_top_pnl,
1275:         top_market_net_share=net_share,
1276:         status=concentration_status,
1277:     )
