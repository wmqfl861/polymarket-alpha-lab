730: def test_candidate_for_market_over_matches_legacy_builder_bitwise(
731:     case_id: str, tmp_path: Path
732: ) -> None:
733:     """FX-10 headline proof: the generic builder's O/U over output IS the
734:     frozen builder's output, bit for bit, on every frozen r23 fixture at
735:     its frozen line."""
736:     case, home, away, line = _r23_case_meta(case_id)
737:     snapshot = _load_r23_snapshot(tmp_path)
738: 
739:     legacy = soccer_model.candidate_from_variants(
740:         snapshot,
741:         home,
742:         "EPL",
743:         away,
744:         "EPL",
745:         line,
746:         case["match"],
747:         case["market_id"],
748:         case["entry_ask_vwap250"],
749:     )
750:     env = soccer_model.candidate_for_market(
751:         snapshot,
752:         home,
753:         "EPL",
754:         away,
755:         "EPL",
756:         case["match"],
757:         case["market_id"],
758:         case["entry_ask_vwap250"],
759:         kind="total",
760:         side="over",
761:         line=line,
762:     )
763:     assert legacy is not None and env is not None
764:     # Bitwise: identical code path, identical floats, identical fields.
765:     assert env.candidate == legacy
766:     assert env.candidate.qs_variants == legacy.qs_variants
767:     assert env.candidate.model_median == legacy.model_median
768:     assert env.candidate.model_range == legacy.model_range
769:     assert env.candidate.question == legacy.question
770:     assert env.candidate.lambda_home == legacy.lambda_home
771:     assert env.candidate.lambda_away == legacy.lambda_away
772:     # Envelope context for the frozen over path.
773:     assert env.kind == "total" and env.side == "over"
774:     assert env.line == line and env.team_side is None
775:     assert env.quote_source == "over_probability"
776:     assert env.complement is False
777:     assert env.bridge_consulted is False and env.bridge_source is None
