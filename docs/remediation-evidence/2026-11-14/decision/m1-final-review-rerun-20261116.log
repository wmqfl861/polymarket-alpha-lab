1363: def decide_entry(request: EntryRequest) -> EntryDecision:
1364:     """Decide paper-entry candidacy for one explicit request.
1365: 
1366:     Runs the canonical step order (:data:`STEP_ORDER`), collecting
1367:     EVERY rejection reason (a ``blocked`` dependency still lets the
1368:     remaining computable checks run and record their own outcomes).
1369:     Returns an immutable :class:`EntryDecision` whose ``accepted`` is
1370:     True iff ``reasons`` is empty. Pure computation; see the module
1371:     docstring for the FX-13/FX-06 evidence contracts.
1372:     """
1373: 
1374:     reasons: list[str] = []
1375:     steps: list[StepResult] = []
1376:     levels = list(request.book)
1377:     kind_normalized = _normalize_kind(request.market_kind)
1378: 
1379:     # 1. book freshness
1380:     step = _step_book_freshness(request)
1381:     steps.append(step)
1382:     reasons.extend(step.reasons)
1383: 
1384:     # 2. suspension policy
1385:     step, _suspension = _step_suspension(request)
1386:     steps.append(step)
1387:     reasons.extend(step.reasons)
1388: 
1389:     # 3. explicit fee category (FX-06/R06)
1390:     step, fee_rate = _step_fee(request)
1391:     steps.append(step)
1392:     reasons.extend(step.reasons)
1393: 
1394:     # 4. under-risk screen (feeds the gate bar)
1395:     quote_probe = request.model_quote if kind_normalized not in CRYPTO_KINDS else None
1396:     step, under_risk_flagged = _step_under_risk(request, kind_normalized, quote_probe)
1397:     steps.append(step)
1398:     reasons.extend(step.reasons)
1399: 
1400:     # 5. FX-13 crypto direction precondition + quote derivation
1401:     step, quote_pack = _step_crypto_direction(request, kind_normalized, levels)
1402:     steps.append(step)
1403:     reasons.extend(step.reasons)
1404:     quote = quote_pack[0] if quote_pack is not None else None
1405:     crypto_evidence = quote_pack[1] if quote_pack is not None else None
1406: 
1407:     # 6. the frozen gate set (original $250 ASK acceptance walk inside)
1408:     step, report = _step_gate(request, quote, fee_rate, under_risk_flagged, levels)
1409:     steps.append(step)
1410:     reasons.extend(step.reasons)
1411: 
1412:     # 7. strict crossbridge + cross-league match-winner check
1413:     step, cross_mw, bridge_digest = _step_cross_league(request, kind_normalized, report)
1414:     steps.append(step)
1415:     reasons.extend(step.reasons)
1416: 
1417:     # 8. held-fixture correlation
1418:     correlation = risk_policy.held_fixture_add_allowed(request.held_sides, request.side)
1419:     if correlation.allowed:
1420:         step = StepResult(STEP_HELD_FIXTURE, STATUS_PASS, (), correlation, correlation.reason)
1421:     else:
1422:         step = StepResult(
1423:             STEP_HELD_FIXTURE, STATUS_FAIL, (REASON_HELD_FIXTURE_BLOCKED,), correlation,
1424:             correlation.reason,
1425:         )
1426:         reasons.append(REASON_HELD_FIXTURE_BLOCKED)
1427:     steps.append(step)
1428: 
1429:     # 9. sizing (class derived here; not caller-overridable)
1430:     step, tier, notional, market_class = _step_sizing(request, kind_normalized, report)
1431:     steps.append(step)
1432:     reasons.extend(step.reasons)
1433: 
1434:     # 10. actual-stake walk over the same raw book
1435:     step, actual_walk = _step_actual_walk(levels, notional)
1436:     steps.append(step)
1437:     reasons.extend(step.reasons)
1438: 
1439:     # 11. acceptance-notional cap (the acceptance walk was $250)
1440:     if notional is None:
1441:         steps.append(
1442:             StepResult(
1443:                 STEP_NOTIONAL_CAP, STATUS_BLOCKED, (), None,
1444:                 "notional cap blocked: no notional (see sizing step)",
