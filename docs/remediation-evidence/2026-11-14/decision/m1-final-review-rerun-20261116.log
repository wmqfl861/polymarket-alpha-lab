52:         market_type="ou_over",
53:         gate_version="gates-v1",
54:         market_key="mk1",
55:         model_probability=0.65,
56:         market_mid=0.50,
57:         accepted=True,
58:         stake=100.0,
59:         fill_price=0.50,
60:         side="YES",
61:         fee_category="sports",
62:         fill_provenance=ev.FILL_BOOK_WALK,
63:         outcome="YES",
64:         recorded_pnl=100.0,
65:         decision_time=_T0,
66:         settled_time=_T0 + timedelta(days=1),
