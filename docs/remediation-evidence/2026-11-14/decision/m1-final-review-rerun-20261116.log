341:                        "outcome", "observed_at"]
342:             return [tuple(row[name] for name in columns) for row in self._outcomes], columns
343:         raise AssertionError(f"unexpected SQL reached the stub: {sql}")
344: 
345:     def cursor(self):
346:         return _StubCursor(self)
347: 
348:     def transaction(self):
349:         return _StubTx()
350: 
