388: def conservative_edges_for_terminal(
389:     probabilities: TerminalProbability,
390:     *,
391:     yes_when: str,
392:     yes_ask: float,
393:     no_ask: float,
394: ) -> ConservativeEdges:
395:     """Per-side conservative edges for an at-expiry market (FX-13).
396: 
397:     Direction-explicit wrapper around :func:`conservative_edges`: converts
398:     the terminal record to YES probabilities via
399:     :func:`terminal_yes_probability` first, then applies the unchanged
400:     conservative rule (``fair_yes = min(pA, pB)``,
401:     ``fair_no = 1 - max(pA, pB)``). The rule is symmetric under
402:     complementation, so the two directions mirror exactly: for the same
403:     barrier and symmetric quotes, ``above``'s YES fair value and edge equal
404:     ``below``'s NO fair value and edge.
405: 
406:     Entry points and scan code handling ``above/below on date`` markets
407:     must go through this function rather than calling
408:     :func:`conservative_edges` on a raw terminal record.
409:     """
410:     yes_pair = terminal_yes_probability(probabilities, yes_when=yes_when)
411:     # Structural pass-through: conservative_edges only reads
412:     # convention_a/convention_b, which TerminalYesProbability carries
413:     # already oriented as the market's YES side.
414:     return conservative_edges(
415:         yes_pair,
416:         yes_ask=yes_ask,
417:         no_ask=no_ask,
418:     )

