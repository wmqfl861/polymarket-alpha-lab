198: # ---------------------------------------------------------------------------
199: # Net-of-fees identity with schedule-sourced rates (8.3 item 5)
200: # ---------------------------------------------------------------------------
201: 
202: 
203: def test_net_identity_and_estimated_fee_layers(plan, report):
204:     entry = sum((row.fee_entry for row in plan.settlements), Decimal("0.00"))
205:     exit_leg = sum((row.fee_exit for row in plan.settlements), Decimal("0.00"))
206:     total = sum((row.fee_total for row in plan.settlements), Decimal("0.00"))
207:     gross = sum((row.pnl_gross for row in plan.settlements), Decimal("0.00"))
208:     net = sum((row.pnl_net for row in plan.settlements), Decimal("0.00"))
209:     assert total == entry + exit_leg == Decimal("441.01")
210:     assert gross == Decimal("3768.33")
211:     assert net == Decimal("3327.32")
212:     assert gross - total == net
213:     candidates = {int(c.legacy_source_id): c for c in plan.submission.candidates}
214:     clamped = 0
215:     for row in plan.settlements:
216:         assert row.pnl_net == row.pnl_gross - row.fee_total
217:         stake = candidates[row.legacy_decision_id].entry.stake
218:         raw = row.pnl_gross + stake
219:         if raw < 0:
220:             clamped += 1
221:             assert row.proceeds == Decimal("0.00")  # a loss pays zero
222:         else:
223:             assert row.proceeds == raw
224:     # Exactly one legacy row drifts below zero (id 15: recorded market pnl
225:     # -500.00 on stake 499.80 from integer-share cent drift).
226:     assert clamped == 1
227:     assert f"fees: entry={entry} exit={exit_leg} total={total} " \
228:            "source=estimated schedule-as-of=" in report
229:     assert f"conservation: settlements pnl_gross sum {gross} fee sum " \
230:            f"{total} net sum {net}" in report
231:     assert "net identity: pnl_gross - fee_total == pnl_net: OK" in report
