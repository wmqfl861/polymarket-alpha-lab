90: 
91: #: Version of the replay bundle codec; stored inside every payload and
92: #: checked on replay, so an old bundle never replays under a new reader.
93: REPLAY_BUNDLE_VERSION = 1
94: 
95: #: ONE rounding policy for every numeric field comparison: floats are
96: #: compared after rounding to this many decimals (1e-9 money scale --
97: #: the pipeline's own cent-scale epsilon discipline; no wide epsilon
98: #: ever swallows a tampered fee, price or walk value).
99: REPLAY_NUMERIC_DP = 9
100: 
101: ENTRY_BUNDLE_TOKEN = 'papersim.replay.entry_request'
102: CONSTRUCTION_BUNDLE_TOKEN = 'papersim.replay.construction_failure'
103: 
104: CONSTRUCTOR_SOCCER = 'soccer_model.candidate_for_market'
105: CONSTRUCTION_RETURNED_NONE = 'construction_returned_none'
106: CONSTRUCTION_VALUE_ERROR = 'construction_value_error'
107: 
108: #: The only dataclasses a bundle may reconstruct: the frozen evidence
109: #: records of the reviewed library. Anything else in a ``$record`` tag
110: #: fails replay -- a bundle never names arbitrary code to execute.
111: _RECORD_TYPES = {f'{record_type.__module__}.{record_type.__qualname__}': record_type
112:                  for record_type in (NewsCheck, TouchProbability, TerminalProbability,
113:                                      SoccerCandidate)}
114: 
115: #: The only constructors a construction-failure bundle may re-run.
116: _CONSTRUCTORS = (CONSTRUCTOR_SOCCER,)
117: 
118: #: Sentinel for a construction that no longer reproduces its recorded
119: #: failure (re-run produced a candidate instead of refusing).
120: _CONSTRUCTION_SUCCEEDED = 'construction_succeeded'
121: 
122: _CANDIDATE_SQL = (
123:     'SELECT c.candidate_id, c.scan_id, c.candidate_key, c.conclusion, c.gate_report, '
124:     'c.rejection_reasons, c.input_payload, c.snapshot_refs, c.order_book, c.book_fetched_at, '
125:     'c.evaluated_at, c.condition_id, c.market_id, c.market_slug, c.side, '
126:     's.code_commit, s.schema_version, s.gate_version, s.finished_at '
127:     'FROM papersim.candidates c JOIN papersim.scan_runs s ON s.scan_id = c.scan_id '
128:     'WHERE c.candidate_id = %s'
129: )
130: 
131: _EVIDENCE_SQL = (
132:     'SELECT evidence_id, evidence_role, observed_at, model_probability, market_ref_kind, '
133:     'market_ref, token_ref, side, bid, ask, mid, last, book_sha256, snapshot_sha256, '
134:     'source_kind, source_ref FROM papersim.candidate_price_evidence '
135:     'WHERE candidate_id = %s AND evidence_role = \'DECISION\' ORDER BY evidence_id LIMIT 1'
136: )
137: 
138: 
139: class PapersimReplayError(ValueError):
140:     """One explicit replay failure: a stable code plus a detail string."""
141: 
142:     def __init__(self, code: str, detail: str = ''):
143:         super().__init__(code if not detail else f'{code}: {detail}')
144:         self.code = code
145:         self.detail = detail
