112: def papersim_pending_migrations(catalog, applied):
113:     """Return the unapplied tail; refuse any non-prefix history."""
114:     if type(applied) is not list or len(applied) > len(catalog):
115:         _fail('papersim_migration_history_conflict')
116:     expected = [{'name': name, 'sha256': digest} for name, digest, _ in catalog]
