1524:             available = risk_policy.bankroll_available(
1525:                 request.bankroll, request.cash, request.reserved
1526:             )
1527:         except (TypeError, ValueError) as exc:
1528:             steps.append(
1529:                 StepResult(
1530:                     STEP_BANKROLL,
1531:                     STATUS_ERROR,
1532:                     (REASON_STEP_ERROR,),
1533:                     None,
1534:                     f"bankroll arithmetic rejected the evidence: {exc}",
1535:                 )
1536:             )
1537:             reasons.append(REASON_STEP_ERROR)
1538:         else:
