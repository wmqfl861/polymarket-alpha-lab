120: 
121: 
122: def read_applied_migrations(conn) -> list[dict]:
123:     """Read the papersim ledger as the V1-shaped name/sha256 list.
124: 
125:     A database whose ``papersim_private.migrations`` does not exist yet is
126:     a PRE-bootstrap managed face (the bootstrap migration itself creates
127:     the ledger), so it reads as an empty applied list; anything else is a
128:     real ledger failure. The read runs inside its own transaction block
129:     (a SAVEPOINT when called inside one) so the undefined-table probe on a
130:     fresh face cannot abort the caller's open transaction. The driver
131:     error type is matched by class name so this module keeps no driver
132:     import.
133:     """
134:     try:
135:         with conn.transaction():
136:             cursor = conn.cursor()
137:             cursor.execute("SELECT coalesce(json_agg(json_build_object('name',name,'sha256',sha256) "
138:                            "ORDER BY name),'[]'::json) FROM " + LEDGER_RELATION)
139:             row = cursor.fetchone()
140:     except Exception as error:
141:         if type(error).__name__ == 'UndefinedTable':
142:             return []
143:         raise PapersimMigrationError('papersim_migration_ledger_missing') from error
144:     if row is None or row[0] is None:
145:         return []
146:     applied = row[0]
147:     if isinstance(applied, str):  # drivers may deliver json aggregates as text
148:         applied = json.loads(applied)
149:     if type(applied) is not list:
150:         _fail('papersim_migration_ledger_missing')
151:     return applied
152: 
153: 
154: def migration_status(conn, repo_root: Path) -> dict:
155:     """Report applied and pending migration names after prefix validation."""
156:     catalog = papersim_migration_catalog(repo_root)
157:     applied = read_applied_migrations(conn)
158:     pending = papersim_pending_migrations(catalog, applied)
159:     return {'applied': [row['name'] for row in applied],
160:             'pending': [name for name, _, _ in pending]}
161: 
162: 
163: def apply_pending_migrations(conn, repo_root: Path, *, lock_key: int = PAPERSIM_LOCK_KEY) -> dict:
164:     """Apply the verified pending tail; one transaction per migration.
165: 
166:     Per migration (design section 2.6): BEGIN; statement/lock timeouts;
167:     ``pg_advisory_xact_lock(PAPERSIM_LOCK_KEY)``; RE-READ the history under
168:     the lock (READ COMMITTED sees concurrently committed receipts and skips
169:     them idempotently); execute the body; insert the receipt; COMMIT. Any
170:     failure rolls back both DDL and receipt; the already-committed prefix is
171:     never replayed or repaired by hand.
172:     """
173:     catalog = papersim_migration_catalog(repo_root)
174:     applied = read_applied_migrations(conn)
175:     pending = papersim_pending_migrations(catalog, applied)
176:     applied_count = 0
177:     for name, digest, body in pending:
178:         with conn.transaction():
179:             cursor = conn.cursor()
180:             cursor.execute("SET LOCAL statement_timeout = '30s'")
181:             cursor.execute("SET LOCAL lock_timeout = '5s'")
182:             cursor.execute("SELECT pg_advisory_xact_lock(%s)", (lock_key,))
183:             remaining = papersim_pending_migrations(catalog, read_applied_migrations(conn))
184:             if name not in {row[0] for row in remaining}:
185:                 # A concurrent applier committed this migration while we
186:                 # waited for the lock; the receipt is already correct.
187:                 continue
188:             try:
189:                 cursor.execute(body)
190:                 cursor.execute("INSERT INTO " + LEDGER_RELATION + "(name,sha256) VALUES (%s,%s)",
191:                                (name, digest))
192:             except Exception as error:  # rollback happens via the context manager
193:                 raise PapersimMigrationError('papersim_migration_apply_failed') from error
194:         applied_count += 1
195:     return {'applied': applied_count, 'pending_before': len(pending)}
