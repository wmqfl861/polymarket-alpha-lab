268:         if self.fee_category is not None:
269:             fees.taker_fee_rate(self.fee_category)  # validates the category
270:         if self.match_key is not None and not str(self.match_key).strip():
271:             raise ValueError("match_key must be a non-empty string when set")
272: 
273: 
274: def _require_finite(value: float, name: str) -> None:
275:     if type(value) not in (int, float) or not math.isfinite(value):
276:         raise ValueError(f"{name} must be a finite number, got {value!r}")
277: 
278: 
279: def _require_probability(value: float | None, name: str, *,
280:                          closed: bool = False) -> None:
281:     if value is None:
282:         return
283:     _require_finite(value, name)
284:     if closed:
285:         if not 0.0 <= value <= 1.0:
286:             raise ValueError(f"{name} must be in the [0, 1] interval")
287:     elif not 0.0 < value < 1.0:
288:         raise ValueError(f"{name} must be in the (0, 1) interval")
289: 
290: 
291: def natural_hit(side: str, outcome: str) -> bool:
292:     """Side-aligned hit test, mirroring ``ledger._natural_hit`` verbatim.
293: 
294:     That private helper mirrors the fixed ``forecast_calibration`` view
295:     expression (``YES``/``YES-basket`` hit when the outcome equals the
296:     side; ``NO``/``NO-basket`` hit on the natural ``NO``). This public
297:     mirror is pinned against the public ``ledger.settle_natural``
298:     arithmetic by tests (a hit is exactly a positive settlement PnL).
299:     """
300:     if side in ("YES", "YES-basket"):
301:         return outcome == side
302:     if side in ("NO", "NO-basket"):
303:         return outcome == "NO"
304:     raise ValueError(f"unknown side: {side!r}")
305: 
306: 
307: def _decimal_probability(value: float) -> Decimal:
308:     """Convert one float probability to the shared scoring module's Decimal.
309: 
310:     Entry-point conversion only (the scoring module owns the semantics):
311:     ``Decimal(str(value))`` avoids binary-float noise, then quantize to the
312:     module's ``QUANTUM`` (1e-12) with its ``ROUND_HALF_EVEN``. This never
313:     clips endpoints: 0 and 1 stay 0 and 1.
314:     """
315:     return Decimal(str(value)).quantize(QUANTUM, rounding=ROUND_HALF_EVEN)
420: class ConcentrationMetrics:
421:     """Profit concentration of one queue, gross AND net of fees.
422: 
423:     The gross fields keep their historical-report role (the frozen 10-30
424:     regression anchors: total 2552.43 / top 1305.20 / share 51.1%). The
425:     ``*net*`` fields (M1 final review P2-02) are the net-of-fees numbers
426:     the OD-G criterion E verdict reads: plan section 5 B-condition
427:     semantics make every PnL used for promotion net of fees.
428:     """
429: 
430:     total_pnl: float
431:     top_market_key: str | None
432:     top_market_pnl: float | None
433:     top_market_share: float | None  # None/UNDEFINED when total pnl <= 0
434:     net_total_pnl: float
435:     top_market_net_key: str | None
436:     top_market_net_pnl: float | None
437:     top_market_net_share: float | None  # None when net total pnl <= 0
438:     status: str
534: def criterion_b(
535:     entries: int,
536:     book_walk_entries: int,
537:     entries_with_fee_data: int,
538:     exited_entries: int,
539:     exited_with_fee_data: int,
540: ) -> CriterionResult:
541:     """B cost: fills walked the book at the actual stake, every counted PnL
542:     is net of fees, and exits carry sell fees. This is a provenance
543:     standard: missing evidence is NOT_ASSESSABLE, never a silent PASS."""
544:     gaps = []
545:     if entries == 0:
546:         gaps.append("no entries to evidence cost handling")
547:     if book_walk_entries != entries:
548:         gaps.append(
549:             f"{entries - book_walk_entries} of {entries} entries lack "
550:             "book-walk fill provenance"
551:         )
552:     if entries_with_fee_data != entries:
553:         gaps.append(
554:             f"{entries - entries_with_fee_data} of {entries} entries lack "
555:             "fee data"
556:         )
557:     if exited_with_fee_data != exited_entries:
558:         gaps.append(
559:             f"{exited_entries - exited_with_fee_data} of {exited_entries} "
560:             "exits lack sell-fee data"
561:         )
562:     if gaps:
563:         return CriterionResult("B", VERDICT_NOT_ASSESSABLE, tuple(gaps))
564:     return CriterionResult("B", VERDICT_PASS, ())
565: 
628: def criterion_e(
629:     net_roi: float | None,
630:     top_market_net_share: float | None,
631:     max_drawdown: float | None,
632:     stake: float,
633: ) -> CriterionResult:
634:     """E outcome: net-of-fees ROI point estimate > 0 (strict), the most
635:     profitable single market < 30% of the queue's total NET-of-fees PnL
636:     (strict; UNDEFINED when the total net PnL is not positive), and max
637:     drawdown <= 10 standard units of $250 (inclusive).
638: 
639:     M1 final review P2-02: the concentration input is the net-of-fees
640:     share (``ConcentrationMetrics.top_market_net_share``) per the plan
641:     section 5 B-condition semantics — every PnL used for the promotion
642:     verdict is after fees. The gross share stays a reported historical
643:     metric only and must never gate this criterion."""
644:     if stake <= 0 or net_roi is None or max_drawdown is None:
645:         return CriterionResult(
646:             "E", VERDICT_NOT_ASSESSABLE,
647:             ("no resolved entries: outcome criteria not measurable",),
648:         )
649:     failures = []
650:     if net_roi <= PROMOTION_NET_ROI_MIN:
651:         failures.append(f"net ROI {net_roi:.4f} <= 0")
652:     if top_market_net_share is None:
653:         failures.append(
654:             "profit concentration undefined (total net pnl not positive)"
655:         )
656:     elif top_market_net_share >= PROMOTION_TOP_MARKET_SHARE_MAX:
657:         failures.append(
658:             f"top market {top_market_net_share:.1%} of total net pnl >= "
659:             f"{PROMOTION_TOP_MARKET_SHARE_MAX:.0%}"
660:         )
661:     if max_drawdown > PROMOTION_MAX_DRAWDOWN_USD:
662:         failures.append(
663:             f"max drawdown ${max_drawdown:.2f} exceeds "
664:             f"${PROMOTION_MAX_DRAWDOWN_USD:.2f}"
665:         )
666:     if failures:
667:         return CriterionResult("E", VERDICT_FAIL, tuple(failures))
668:     return CriterionResult("E", VERDICT_PASS, ())
669: 
670: 
671: def criterion_f() -> CriterionResult:
672:     """F operations: 30 days of unattended scheduled scans with no manual
673:     database edits, daily bankroll identity and per-row replay. Depends on
674:     M2 run evidence; M1 must never claim it."""
675:     return CriterionResult(
676:         "F", VERDICT_NOT_ASSESSABLE_M1,
677:         ("requires M2 unattended-run evidence: 30 days of scheduled scans, "
678:          "no manual DB edits, daily bankroll identity, per-candidate "
679:          "replay",),
680:     )
861: def _row_gross_pnl(
862:     candidate: EvaluationCandidate, pnl_basis: str
863: ) -> float:
864:     outcome = candidate.outcome
865:     stake = float(candidate.stake)
866:     price = float(candidate.fill_price)
867:     if pnl_basis == PNL_BASIS_RECORDED or outcome == ledger.EXITED_OUTCOME:
868:         if candidate.recorded_pnl is None:
869:             raise ValueError(
870:                 "recorded mode and EXITED rows require a recorded 'pnl'"
871:             )
872:         return float(candidate.recorded_pnl)
873:     if outcome in ledger.SETTLED_LABEL_OUTCOMES:
874:         return (stake / price - stake) if outcome == ledger.WIN_OUTCOME else -stake
875:     return ledger.settle_natural(
876:         stake, price, str(candidate.side), outcome
877:     ).pnl
878: 
879: 
880: @dataclass(frozen=True)
881: class _RoiRow:
882:     candidate: EvaluationCandidate
883:     gross: float
884:     entry_fee: float
885:     exit_fee: float
886: 
887:     @property
888:     def net(self) -> float:
889:         return self.gross - self.entry_fee - self.exit_fee
890: 
891: 
892: def _cluster_roi_rows(
893:     rows: Sequence[_RoiRow],
894: ) -> list[list[_RoiRow]]:
895:     """Cluster ROI rows by the frozen cluster key of their candidates."""
896:     groups: dict[tuple[str, str], list[_RoiRow]] = {}
897:     order: list[tuple[str, str]] = []
898:     for row in rows:
899:         key = _cluster_key(row.candidate)
900:         if key not in groups:
901:             groups[key] = []
902:             order.append(key)
903:         groups[key].append(row)
904:     return [groups[key] for key in order]
905: 
906: 
907: def _roi_metrics(
908:     counted: Sequence[EvaluationCandidate], pnl_basis: str,
909: ) -> tuple[RoiMetrics, tuple[_RoiRow, ...]]:
910:     rows: list[_RoiRow] = []
911:     for candidate in counted:
912:         gross = _row_gross_pnl(candidate, pnl_basis)
913:         rate = fees.taker_fee_rate(candidate.fee_category)
914:         stake = float(candidate.stake)
915:         price = float(candidate.fill_price)
916:         entry_fee = fees.entry_fee(stake, price, rate)
917:         exit_fee = 0.0
918:         if candidate.outcome == ledger.EXITED_OUTCOME:
919:             shares = stake / price
920:             exit_price = (gross + stake) / shares
921:             exit_fee = fees.exit_fee(shares, exit_price, rate)
922:         rows.append(_RoiRow(candidate, gross, entry_fee, exit_fee))
923:     stake = sum(float(row.candidate.stake) for row in rows)
924:     gross = sum(row.gross for row in rows)
925:     entry_fees = sum(row.entry_fee for row in rows)
926:     exit_fees = sum(row.exit_fee for row in rows)
927:     net = sum(row.net for row in rows)
928:     status = STATUS_OK if rows else STATUS_INSUFFICIENT
929:     gross_roi = gross / stake if stake else None
930:     net_roi = net / stake if stake else None
931:     if rows:
932:         grouped = _cluster_roi_rows(rows)
933:         gross_clusters = [
934:             [(row.gross, float(row.candidate.stake)) for row in group]
935:             for group in grouped
936:         ]
937:         net_clusters = [
938:             [(row.net, float(row.candidate.stake)) for row in group]
939:             for group in grouped
940:         ]
941:         gross_ci = _bootstrap_ratio_ci(gross_clusters)
942:         net_ci = _bootstrap_ratio_ci(net_clusters)
943:     else:
944:         gross_ci = (None, None)
945:         net_ci = (None, None)
946:     excluding: float | None = None
947:     if rows and gross > 0:
948:         by_market: dict[str, list[_RoiRow]] = {}
949:         for row in rows:
950:             by_market.setdefault(row.candidate.market_key, []).append(row)
951:         top = max(by_market.values(), key=lambda group: sum(
952:             row.gross for row in group
953:         ))
954:         top_ids = {id(row) for row in top}
955:         excluded_rows = [row for row in rows if id(row) not in top_ids]
956:         excluded_stake = sum(
957:             float(row.candidate.stake) for row in excluded_rows
958:         )
959:         if excluded_stake > 0:
960:             excluding = sum(row.gross for row in excluded_rows) / excluded_stake
961:     return (
962:         RoiMetrics(
963:             counted=len(rows),
964:             stake=stake,
965:             gross_pnl=gross,
966:             entry_fees=entry_fees,
967:             exit_fees=exit_fees,
968:             net_pnl=net,
969:             gross_roi=gross_roi,
970:             net_roi=net_roi,
971:             gross_roi_ci=gross_ci,
972:             net_roi_ci=net_ci,
973:             excluding_top_market_roi=excluding,
974:             status=status,
975:             fee_schedule_as_of=fees.FEE_SCHEDULE_AS_OF,
976:         ),
977:         tuple(rows),
978:     )
1153: def _evaluate_queue(
1154:     key: QueueKey,
