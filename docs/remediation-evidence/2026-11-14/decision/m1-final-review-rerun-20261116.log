38: SNAPSHOT_PATH = ROOT / "docs" / "paper-sim" / "review-2026-10-30" / "settled_ledger.json"
39: 
40: _T0 = datetime(2026, 10, 1, 12, 0, 0, tzinfo=timezone.utc)
