tests/test_papersim_soccer_model.py
1: """WP-P1 W1 tests: 10-variant xG-Poisson soccer model.
2: 
3: Three layers:
4: 
5: - Unit invariants on synthetic rates: the Dixon-Coles tau touches ONLY
6:   the 0-0 / 0-1 / 1-0 / 1-1 cells, preserves row and column marginals
7:   and total mass (the four corrections cancel exactly for independent
8:   Poisson cells), the sweep set matches the frozen lineage list, and the
9:   market helpers follow the lineage push semantics. The production
10:   ``score_grid(..., rho=...)`` is additionally compared cell-by-cell
11:   against a from-first-principles recomputation (FX1, codex finding 10).
12: - Regression anchors: recompute the four frozen round-23 EPL cases from
13:   ``tests/fixtures/papersim/regression_r23_soccer.json`` and assert the
14:   medians, ranges and all ten per-variant quotes within 1e-4, plus the
15:   banned cross-league path (HOF-LYO) asserting ``None``.
16: - Candidate-builder gates (FX1, codex finding 1): the public
17:   snapshot-driven ``candidate_from_variants`` builder carries the TRUE
18:   per-variant quotes into the fair range — BOU-LEE O2.5 must be
19:   REJECTED by the frozen gates with the true 6.09c spread reproduced,
20:   while the pair-level ``over_under_quote`` stub (documented NOT
21:   gate-safe) collapses the same sweep to ten identical quotes.
22: """
23: 
24: from __future__ import annotations
25: 
26: import json
27: import math
28: from pathlib import Path
29: 
30: import pytest
31: 
32: from polymarket_alpha_lab.papersim import gates, soccer_model, xg
33: 
34: FIXTURES = Path(__file__).parent / "fixtures" / "papersim"
35: 
36: # EPL 2025-26 prior-season aggregates frozen at full float precision from
37: # /home/ubuntu/paper-sim/round23/raw/xg_epl_23.json key "EPL_2025" (380
38: # isResult dates, 38-row team histories; computed once during WP-P1 W1).
39: # The P0 excerpt froze only the eight EPL_2026 team rows, so the
40: # regression snapshot rebuilds the prior-season block from these
41: # aggregates: the single synthetic date row reproduces the league base
42: # rates exactly and the single-row histories reproduce each ever-present
43: # team's 2025 mean xG / xGA exactly. Promoted sides (Hull, Ipswich) are
44: # deliberately absent, exercising the league-average fallback exactly as
45: # the r23 model did for teams missing from the prior season.
46: EPL_2025_HOME_RATE = 1.6946258894736843
47: EPL_2025_AWAY_RATE = 1.3643311084210525
48: EPL_2025_TEAM_RATES = {
49:     "Bournemouth": (1.758804, 1.4939418157894737),
50:     "Brentford": (1.7435966842105264, 1.5555292368421054),
51:     "Chelsea": (1.9003278947368418, 1.5294069210526315),
52:     "Leeds": (1.5729118421052632, 1.4822607894736841),
53:     "Manchester United": (1.8996939473684211, 1.3231953684210527),
54:     "Nottingham Forest": (1.287795947368421, 1.7036741052631579),
55: }
56: 
57: LH, LA = 1.894, 1.364  # frozen BRE-FOR median rates
58: DC_PAIRS = ((0, 0), (0, 1), (1, 0), (1, 1))
