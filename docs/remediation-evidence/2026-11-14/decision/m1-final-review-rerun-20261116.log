319:     def __init__(self, candidates, evidence=(), outcomes=()):
320:         self._candidates = candidates
321:         self._evidence = evidence
322:         self._outcomes = outcomes
323:         self.statements: list[str] = []
324: 
325:     def _execute(self, sql):
326:         if sql.startswith("SELECT c.candidate_id"):
327:             columns = ["candidate_id", "candidate_key", "conclusion", "side",
328:                        "market_type", "market_kind", "model_name", "model_version",
329:                        "evaluated_at", "condition_id", "market_id", "market_slug",
