477: 
478: def bind_construction_failure(*, team: str, candidate_key: str, evaluated_at: datetime,
479:                               inputs: Mapping, side: str = 'YES', market_kind: str = 'other',
480:                               market_id: str | None = None, market_slug: str | None = None,
481:                               condition_id: str | None = None, market_type: str | None = None,
482:                               model_name: str = 'soccer',
483:                               model_version: str = 'soccer-r23-construction',
484:                               snapshot_refs: tuple[str, ...] | list = (),
485:                               constructor: str = CONSTRUCTOR_SOCCER) -> store.CandidateSubmission:
486:     """Record a construction failure by RE-RUNNING the pure constructor.
487: 
488:     The failure recorded is the failure observed: ``inputs`` are proven
489:     codec-clean, the constructor runs once here, and its refusal (None
490:     or ValueError) becomes the recorded ``rejection_reasons`` entry and
491:     bundle payload. A construction that unexpectedly SUCCEEDS refuses
492:     to be recorded as failed.
493:     """
494:     if constructor not in _CONSTRUCTORS:
495:         raise PapersimReplayError('papersim_replay_constructor_unknown', constructor)
496:     clean = {key: _decode(_encode(inputs[key])) for key in inputs}
497:     try:
498:         outcome = soccer_model.candidate_for_market(**clean)
499:     except ValueError as exc:
500:         failure, failure_detail = CONSTRUCTION_VALUE_ERROR, str(exc)
501:     else:
502:         if outcome is None:
503:             failure, failure_detail = CONSTRUCTION_RETURNED_NONE, ''
504:         else:
505:             raise PapersimReplayError('papersim_replay_construction_succeeded')
506:     return store.CandidateSubmission(
507:         candidate_key=candidate_key, conclusion='CONSTRUCTION_FAILED', side=side,
508:         market_kind=market_kind, team=team, model_name=model_name, model_version=model_version,
509:         input_payload=construction_payload(clean, constructor=constructor, failure=failure,
510:                                            failure_detail=failure_detail),
511:         gate_report='{}', evaluated_at=evaluated_at, condition_id=condition_id,
512:         market_id=market_id, market_slug=market_slug, market_type=market_type,
513:         snapshot_refs=json.dumps(list(snapshot_refs), separators=(',', ':')),
514:         rejection_reasons=json.dumps([failure], separators=(',', ':')))
515: 
539: def _compare(stored, recomputed, path: str) -> None:
540:     """Structural comparison under the ONE rounding policy."""
541:     if stored is None or recomputed is None:
542:         if stored is not recomputed:
543:             raise PapersimReplayError('papersim_replay_decision_mismatch', path)
544:         return
545:     if isinstance(stored, bool) or isinstance(recomputed, bool):
546:         if isinstance(stored, bool) and isinstance(recomputed, bool) and stored == recomputed:
547:             return
548:         raise PapersimReplayError('papersim_replay_decision_mismatch', path)
549:     if isinstance(stored, (int, float, Decimal)) and isinstance(recomputed, (int, float, Decimal)):
550:         if _same_number(stored, recomputed):
551:             return
552:         raise PapersimReplayError('papersim_replay_decision_mismatch', path)
553:     if isinstance(stored, str) or isinstance(recomputed, str):
554:         if stored != recomputed:
555:             raise PapersimReplayError('papersim_replay_decision_mismatch', path)
556:         return
557:     if isinstance(stored, list) and isinstance(recomputed, list):
558:         if len(stored) != len(recomputed):
559:             raise PapersimReplayError('papersim_replay_decision_mismatch', path)
560:         for index, (one, two) in enumerate(zip(stored, recomputed, strict=True)):
561:             _compare(one, two, f'{path}[{index}]')
562:         return
563:     if isinstance(stored, Mapping) and isinstance(recomputed, Mapping):
564:         if set(stored) != set(recomputed):
565:             raise PapersimReplayError('papersim_replay_decision_mismatch', path)
566:         for key in stored:
567:             _compare(stored[key], recomputed[key], f'{path}.{key}')
568:         return
569:     if stored != recomputed:
570:         raise PapersimReplayError('papersim_replay_decision_mismatch', path)
571: 
572: 
573: def _fetch_one(conn, sql: str, params) -> dict | None:
574:     with conn.transaction():
575:         cursor = conn.cursor()
576:         cursor.execute(sql, params)
577:         columns = [description.name for description in cursor.description]
578:         row = cursor.fetchone()
579:     if row is None:
580:         return None
581:     return dict(zip(columns, row, strict=True))
582: 
583: 
584: def _require_trusted_commit(trusted_code_commit) -> str:
585:     if not isinstance(trusted_code_commit, str) or len(trusted_code_commit) != 40 \
586:             or any(character not in '0123456789abcdef'
587:                    for character in trusted_code_commit):
588:         raise PapersimReplayError('papersim_replay_trusted_commit_invalid')
589:     return trusted_code_commit
590: 
591: 
592: def _run_constructor(payload: Mapping) -> tuple[str, str]:
593:     """Re-run the recorded pure constructor on the recorded inputs."""
594:     constructor = payload.get('constructor')
595:     if constructor not in _CONSTRUCTORS:
596:         raise PapersimReplayError('papersim_replay_constructor_unknown', str(constructor))
597:     try:
598:         inputs = {key: _decode(value) for key, value in payload['inputs'].items()}
599:     except PapersimReplayError:
600:         raise
601:     except (KeyError, TypeError, ValueError) as exc:
602:         raise PapersimReplayError('papersim_replay_bundle_invalid', str(exc)) from exc
603:     try:
604:         outcome = soccer_model.candidate_for_market(**inputs)
605:     except ValueError as exc:
606:         # The constructor's OWN refusal is a construction failure, not a
607:         # bundle problem -- it must replay as the recorded ValueError.
608:         return CONSTRUCTION_VALUE_ERROR, str(exc)
609:     if outcome is None:
610:         return CONSTRUCTION_RETURNED_NONE, ''
611:     return _CONSTRUCTION_SUCCEEDED, ''
612: 
613: 
614: def replay(conn, candidate_id: int, *, trusted_code_commit: str,
615:            expected_scan_schema_version: int = REPLAY_BUNDLE_VERSION,
616:            expected_snapshot_schema_version: int | None = None) -> dict:
617:     """Read-only forensic replay of one recorded candidate.
618: 
619:     Verifies the recorded code commit against the operator-supplied
620:     TRUSTED commit (never the ambient HEAD), the scan schema version,
621:     every cited snapshot (hash, byte length, optional schema version),
622:     the decision-time evidence coherence, and then recomputes
623:     ``decide_entry`` in this reviewed environment and compares every
624:     recorded field under the single rounding policy. Returns the check
625:     summary on match; raises :class:`PapersimReplayError` on the first
626:     explicit failure. Issues SELECT statements only.
627:     """
628:     if isinstance(candidate_id, bool) or not isinstance(candidate_id, int):
629:         raise PapersimReplayError('papersim_replay_candidate_id_invalid')
630:     trusted = _require_trusted_commit(trusted_code_commit)
631:     row = _fetch_one(conn, _CANDIDATE_SQL, (candidate_id,))
632:     if row is None:
633:         raise PapersimReplayError('papersim_replay_candidate_missing', str(candidate_id))
634:     checks: list[str] = []
635:     if row['code_commit'] is None:
636:         raise PapersimReplayError('papersim_replay_code_commit_missing')
637:     if row['code_commit'] != trusted:
638:         raise PapersimReplayError('papersim_replay_code_commit_mismatch',
639:                                   f'{row["code_commit"]} != {trusted}')
640:     checks.append('code_commit')
641:     if int(row['schema_version']) != expected_scan_schema_version:
642:         raise PapersimReplayError('papersim_replay_schema_version_mismatch',
643:                                   f'{row["schema_version"]} != {expected_scan_schema_version}')
644:     checks.append('schema_version')
645:     for reference in _as_json(row['snapshot_refs']) or []:
646:         snapshots.verify_snapshot(conn, reference,
647:                                   expected_schema_version=expected_snapshot_schema_version)
648:     checks.append('snapshots')
649:     if row['conclusion'] == 'CONSTRUCTION_FAILED':
650:         return _replay_construction(row, checks)
651:     return _replay_decision(conn, row, checks)
652: 
653: 
654: def _replay_construction(row: dict, checks: list) -> dict:
655:     payload = _as_json(row['input_payload'])
656:     if not isinstance(payload, Mapping) or payload.get('bundle') != CONSTRUCTION_BUNDLE_TOKEN:
657:         raise PapersimReplayError('papersim_replay_bundle_invalid')
658:     if payload.get('version') != REPLAY_BUNDLE_VERSION:
659:         raise PapersimReplayError('papersim_replay_schema_version_mismatch')
660:     failure, failure_detail = _run_constructor(payload)
661:     recorded_failure = payload.get('failure')
662:     if failure != recorded_failure or failure_detail != payload.get('failure_detail', ''):
663:         raise PapersimReplayError('papersim_replay_construction_mismatch',
664:                                   f'{recorded_failure} vs {failure}')
665:     reasons = _as_json(row['rejection_reasons']) or []
666:     if reasons != [recorded_failure]:
667:         raise PapersimReplayError('papersim_replay_reasons_mismatch', str(reasons))
668:     checks.extend(['constructor', 'rejection_reasons'])
669:     return {'candidate_id': int(row['candidate_id']), 'scan_id': int(row['scan_id']),
670:             'candidate_key': row['candidate_key'], 'mode': 'construction_failure',
671:             'matched': True, 'code_commit': row['code_commit'], 'checks': tuple(checks)}
672: 
673: 
674: def _replay_decision(conn, row: dict, checks: list) -> dict:
675:     request = request_from_replay_bundle(row['input_payload'])
676:     checks.append('bundle')
677:     stored_book = _as_json(row['order_book'])
678:     _compare(stored_book, _encode(list(request.book)), 'order_book')
679:     if row['book_fetched_at'] != request.book_time:
680:         raise PapersimReplayError('papersim_replay_book_time_mismatch')
681:     checks.append('book')
682:     evidence = _fetch_one(conn, _EVIDENCE_SQL, (int(row['candidate_id']),))
683:     if evidence is None:
684:         raise PapersimReplayError('papersim_replay_evidence_missing')
685:     if evidence['observed_at'] != row['evaluated_at']:
686:         raise PapersimReplayError('papersim_replay_evidence_time_mismatch')
687:     ref_column = {'condition_id': 'condition_id', 'market_id': 'market_id',
688:                   'market_slug': 'market_slug'}.get(evidence['market_ref_kind'])
689:     if ref_column is not None and row[ref_column] is not None \
690:             and evidence['market_ref'] != row[ref_column]:
691:         raise PapersimReplayError('papersim_replay_evidence_binding_mismatch')
692:     if evidence['side'] != row['side']:
693:         raise PapersimReplayError('papersim_replay_evidence_binding_mismatch')
694:     checks.append('evidence')
695:     if evidence['book_sha256'] is not None:
696:         stored = snapshots.read_snapshot(conn, evidence['book_sha256'])
697:         if stored is None:
698:             raise PapersimStoreError('papersim_snapshot_missing')
699:         try:
700:             book_snapshot = _as_json(stored['content'].decode('utf-8'))
701:         except (UnicodeDecodeError, PapersimReplayError) as exc:
702:             raise PapersimReplayError('papersim_replay_book_snapshot_mismatch',
703:                                       str(exc)) from exc
704:         _compare(book_snapshot, stored_book, 'book_snapshot')
705:     if evidence['snapshot_sha256'] is not None:
706:         snapshots.verify_snapshot(conn, evidence['snapshot_sha256'])
707:     decision = decide_entry(request)
708:     checks.append('recompute')
709:     if decision.code_sha256 != policy_code_sha256():
710:         raise PapersimReplayError('papersim_replay_policy_fingerprint_mismatch')
711:     payload = _as_json(row['gate_report'])
712:     if not isinstance(payload, Mapping):
713:         raise PapersimReplayError('papersim_replay_bundle_invalid', 'gate_report')
714:     if payload.get('code_sha256') != decision.code_sha256:
715:         raise PapersimReplayError('papersim_replay_policy_fingerprint_mismatch')
716:     if row['gate_version'] != decision.gate_version:
