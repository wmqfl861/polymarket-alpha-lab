151: def test_market_level_pnl_allocated_by_recorded_shares_once(plan):
152:     rows = {row.legacy_decision_id: row for row in plan.settlements
153:             if row.market_id == "3866000"}
154:     assert set(rows) == {1, 14}
155:     # Registered deviation: the design section 1.3 illustration reads
156:     # "743.68 + 561.52" but its own section 7.4 method (recorded shares
157:     # 1456/1099 of 2555, half-even cents, last entry takes the remainder)
158:     # yields 743.79 + 561.41 — still exactly 1305.20 with no residual.
159:     assert rows[1].pnl_gross == Decimal("743.79")
160:     assert rows[14].pnl_gross == Decimal("561.41")
161:     assert rows[1].pnl_gross + rows[14].pnl_gross == Decimal("1305.20")
