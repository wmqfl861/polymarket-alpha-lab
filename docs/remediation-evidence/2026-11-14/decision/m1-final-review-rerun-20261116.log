1490:             )
1491:         else:
1492:             steps.append(
1493:                 StepResult(
1494:                     STEP_TEAM_CAP,
1495:                     STATUS_FAIL,
1496:                     (REASON_TEAM_CAP_EXCEEDED,),
1497:                     team_ok,
1498:                     f"team exposure {request.team_committed} + {notional} exceeds cap "
1499:                     f"{request.team_cap}",
1500:                 )
1501:             )
1502:             reasons.append(REASON_TEAM_CAP_EXCEEDED)
1503: 
1504:     # 13. bankroll / cash cover (principal + entry fee, charged once)
1505:     entry_fee = None
1506:     if notional is None or actual_walk is None or actual_walk.vwap is None:
1507:         steps.append(
1508:             StepResult(
1509:                 STEP_BANKROLL, STATUS_BLOCKED, (), None,
1510:                 "bankroll check blocked: no notional or no walked entry price",
1511:             )
1512:         )
1513:     elif fee_rate is None:
1514:         steps.append(
1515:             StepResult(
1516:                 STEP_BANKROLL, STATUS_BLOCKED, (), None,
1517:                 "bankroll check blocked: entry fee undetermined "
