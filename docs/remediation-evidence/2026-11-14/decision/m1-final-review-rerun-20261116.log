1448:         steps.append(
1449:             StepResult(
1450:                 STEP_NOTIONAL_CAP,
1451:                 STATUS_FAIL,
1452:                 (REASON_NOTIONAL_CAP_EXCEEDED,),
1453:                 notional,
1454:                 f"notional {notional} exceeds the acceptance walk "
1455:                 f"{gates.DEFAULT_NOTIONAL_USD}",
1456:             )
1457:         )
1458:         reasons.append(REASON_NOTIONAL_CAP_EXCEEDED)
1459:     else:
1460:         steps.append(
