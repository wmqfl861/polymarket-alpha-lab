338: def bound_set(db: FakePapersim) -> dict[str, int]:
339:     """Build, bind and persist the full synthetic scan; return candidate ids."""
340:     ids = {}
341:     next_id = [1]
342: 
343:     def persist(submission):
344:         candidate_id = next_id[0]
345:         next_id[0] += 1
346:         db.persist(submission, SCAN, scan_id=1, candidate_id=candidate_id)
347:         ids[submission.candidate_key] = candidate_id
348:         return candidate_id
349: 
350:     for key, request, team, kind, market_id in (
351:             ('k-soccer48-accepted', _soccer48_request(), 'soccer_epl', 'other', '5856164'),
352:             ('k-stale-rejected', _stale_request(), 'soccer_epl', 'other', '5856164'),
353:             ('k-crypto-rejected', _crypto_no_direction_request(), 'crypto_eth', 'terminal',
354:              'm-eth2000-term'),
355:             ('k-bridged-accepted', _bridged_request(), 'soccer_uefa', 'other', 'm-hof-lyo')):
356:         decision = decide_entry(request)
357:         book_digest = db.register(snapshots.SnapshotRegistration(
358:             content=replay.bound_book_bytes(request), kind='clob_book',
359:             source=f'clob:{market_id}', fetched_at=request.book_time))
360:         refs = [book_digest]
361:         book_sha = book_digest
362:         if request.bridge is not None:
363:             bridge_digest = db.register(snapshots.SnapshotRegistration(
364:                 content=json.dumps(replay._encode(request.bridge),
365:                                    separators=(',', ':')).encode('utf-8'),
366:                 kind='league_bridge', source='league_strength:wp-p2a',
367:                 fetched_at=request.book_time))
368:             refs.append(bridge_digest)
369:         entry = replay.bind_entry(decision, entered_at=NOW) if decision.accepted else None
370:         persist(replay.bind_candidate(
371:             request, decision, team=team, candidate_key=key, side='YES', market_kind=kind,
372:             evaluated_at=NOW, market_ref_kind='market_id', market_id=market_id,
373:             median_probability=replay.bound_median_probability(request, decision),
374:             snapshot_refs=refs, book_snapshot_sha256=book_sha, entry=entry))
375:     persist(replay.bind_construction_failure(
376:         team='soccer_uefa', candidate_key='k-construction-none', evaluated_at=NOW,
377:         inputs=CONSTRUCTION_INPUTS_NONE, market_id='m-hof-lyo'))
378:     persist(replay.bind_construction_failure(
379:         team='soccer_epl', candidate_key='k-construction-bad-line', evaluated_at=NOW,
380:         inputs=CONSTRUCTION_INPUTS_BAD_LINE, market_id='m-bre-for'))
381:     return ids
