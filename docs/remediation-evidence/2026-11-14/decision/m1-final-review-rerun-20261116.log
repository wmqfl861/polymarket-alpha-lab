148: # ---------------------------------------------------------------------------
149: # Canonical bundle codec (record side encodes, replay side decodes)
150: # ---------------------------------------------------------------------------
391: def bind_scan_run(*, team: str, started_at: datetime, finished_at: datetime,
392:                   code_commit: str, params: str = '{}', operator: str = 'unattended',
393:                   schema_version: int = REPLAY_BUNDLE_VERSION) -> store.ScanRunRecord:
394:     """The scan identity row: decision clock bounds plus the code commit."""
395:     return store.ScanRunRecord(team=team, started_at=started_at, finished_at=finished_at,
396:                                code_commit=code_commit, schema_version=schema_version,
397:                                gate_version=GATE_VERSION, operator=operator, params=params)
398: 
399: 
400: def bind_entry(decision: EntryDecision, *, entered_at: datetime) -> store.EntrySubmission:
401:     """The single paper entry of an accepted candidate, from its decision."""
402:     if not decision.accepted or decision.notional is None or decision.tier is None \
403:             or decision.actual_walk is None or decision.actual_walk.vwap is None \
404:             or decision.fee_category is None or decision.fee_rate is None \
405:             or decision.entry_fee is None:
406:         raise PapersimReplayError('papersim_replay_entry_fields_missing')
407:     stake = Decimal(str(decision.notional))
408:     price = Decimal(str(decision.actual_walk.vwap))
409:     shares = (stake / price).quantize(Decimal('0.0001'), rounding=ROUND_HALF_UP)
410:     return store.EntrySubmission(stake=stake, price=price, shares=shares,
411:                                  fee_category=decision.fee_category,
412:                                  fee_rate=Decimal(str(decision.fee_rate)),
413:                                  entry_fee=Decimal(str(decision.entry_fee)),
414:                                  fee_source='schedule', tier=decision.tier.tier,
415:                                  entered_at=entered_at)
416: 
417: 
418: def bind_candidate(request: EntryRequest, decision: EntryDecision, *,
419:                    team: str, candidate_key: str, side: str, market_kind: str,
420:                    evaluated_at: datetime,
421:                    market_ref_kind: str = 'market_id',
422:                    market_id: str | None = None, market_slug: str | None = None,
423:                    condition_id: str | None = None, yes_token_id: str | None = None,
424:                    no_token_id: str | None = None, market_type: str | None = None,
425:                    model_name: str = 'soccer', model_version: str | None = None,
426:                    median_probability=None, variant_quotes: str | list = '[]',
427:                    snapshot_refs: tuple[str, ...] | list = (),
428:                    book_snapshot_sha256: str | None = None,
429:                    decision_snapshot_sha256: str | None = None,
430:                    source_kind: str = 'clob_book', source_ref: str | None = None,
431:                    entry: store.EntrySubmission | None = None) -> store.CandidateSubmission:
432:     """Bind one decided request into its replayable candidate row data.
433: 
434:     The bundle carries the full decision-time evidence; the gate report
435:     carries the full ordered reason record; the price evidence row is
436:     the decision-time observation paired with the same market reference
437:     and side; ``snapshot_refs`` cite registered raw bytes. Rejected
438:     candidates bind identically (their reasons are the record).
439:     """
440:     market_ref = (market_id if market_ref_kind == 'market_id' else
441:                   condition_id if market_ref_kind == 'condition_id' else
442:                   market_slug if market_ref_kind == 'market_slug' else None)
443:     if market_ref is None:
444:         raise PapersimReplayError('papersim_replay_binding_market_ref_missing')
445:     if source_ref is None and source_kind != 'operator_attestation':
446:         source_ref = f'{market_ref_kind}:{market_ref}'
447:     ask = None if decision.acceptance_walk is None else decision.acceptance_walk.best
448:     evidence = store.PriceEvidenceObservation(
449:         observed_at=evaluated_at, evidence_role='DECISION',
450:         model_probability=None if median_probability is None else Decimal(str(median_probability)),
451:         market_ref_kind=market_ref_kind, market_ref=market_ref, token_ref=yes_token_id,
452:         side=side, bid=None, ask=None if ask is None else Decimal(str(ask)), mid=None,
453:         book_sha256=book_snapshot_sha256, snapshot_sha256=decision_snapshot_sha256,
454:         source_kind=source_kind, source_ref=source_ref)
455:     return store.CandidateSubmission(
456:         candidate_key=candidate_key,
457:         conclusion='ACCEPTED' if decision.accepted else 'REJECTED',
458:         side=side, market_kind=market_kind, team=team,
459:         model_name=model_name,
460:         model_version=model_version or decision.model_version,
461:         input_payload=replay_bundle_payload(request),
462:         gate_report=decision_report_json(decision),
463:         evaluated_at=evaluated_at,
464:         condition_id=condition_id, market_id=market_id or request.market_id,
465:         market_slug=market_slug, yes_token_id=yes_token_id, no_token_id=no_token_id,
466:         market_type=market_type, binding_version=1,
467:         median_probability=None if median_probability is None
468:         else Decimal(str(median_probability)),
469:         variant_quotes=variant_quotes,
470:         snapshot_refs=json.dumps(list(snapshot_refs), separators=(',', ':')),
471:         rejection_reasons=json.dumps(list(decision.reasons), separators=(',', ':')),
472:         order_book=json.dumps(_encode(list(request.book)), separators=(',', ':'),
473:                               allow_nan=False),
474:         book_fetched_at=request.book_time,
475:         price_evidence=(evidence,), entry=entry)
