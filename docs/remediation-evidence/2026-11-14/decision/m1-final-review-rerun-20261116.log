595: def _open_readonly_connection(args, *, label: str):
596:     """Read-only source connection through the reviewed papersim adapter.
597: 
598:     ``--managed`` opens the project-private managed application face
599:     (its DSN already passed the single audited local validator inside
600:     the adapter, before any connection is constructed); ``--dsn`` is an
601:     explicit DSN for an isolated/throwaway cluster validated by the
602:     same single audited validator. This module opens no connection
603:     itself and never reads the process environment.
604:     """
605:     from polymarket_alpha_lab.papersim import store_psycopg
606:     if args.managed:
607:         return store_psycopg.connect_managed(Path(args.repo_root))
608:     return store_psycopg.connect_explicit(args.dsn, label=label)
609: 
610: 
611: def _fetch_rows(conn, sql: str) -> list[dict]:
612:     with conn.transaction():
613:         cursor = conn.cursor()
614:         cursor.execute(sql)
615:         columns = [description.name for description in cursor.description]
616:         rows = cursor.fetchall()
617:     return [dict(zip(columns, row, strict=True)) for row in rows]
618: 
778: def _cmd_evaluate(args) -> int:
779:     from polymarket_alpha_lab.papersim import evaluation
780: 
781:     try:
782:         if args.json_input is not None:
783:             candidates = _evaluation_candidates_from_json(Path(args.json_input))
784:         else:
785:             connection = _open_readonly_connection(args, label="PAPERSIM_EVALUATION_PG_DSN")
786:             try:
787:                 candidates = _evaluation_candidates_from_store(connection)
788:             finally:
789:                 connection.close()
790:         report = evaluation.evaluate_queues(candidates, pnl_basis=args.pnl_basis)
791:         payload = _jsonify(report)
792:     except (ValueError, OSError) as error:
793:         print(f"evaluate: FAIL: {error}", file=sys.stderr)
794:         return 1
795:     print(json.dumps(payload, sort_keys=True, allow_nan=False))
796:     return 0
797: 
798: 
799: def _cmd_replay(args) -> int:
800:     from polymarket_alpha_lab import replay as replay_engine
801: 
802:     try:
803:         connection = _open_readonly_connection(args, label="PAPERSIM_REPLAY_PG_DSN")
804:         try:
805:             result = replay_engine.replay(connection, args.candidate_id,
806:                                           trusted_code_commit=args.trusted_commit)
807:         finally:
808:             connection.close()
809:         payload = _jsonify(result)
810:     except (ValueError, OSError) as error:
811:         print(f"replay: FAIL: {error}", file=sys.stderr)
812:         return 1
813:     print(json.dumps(payload, sort_keys=True, allow_nan=False))
814:     return 0
