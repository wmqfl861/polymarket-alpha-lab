+@pytest.mark.parametrize('fault',[KeyboardInterrupt(),SystemExit(0)])
+@pytest.mark.parametrize('later',['deadline','wait_error'])
+def test_first_cleanup_interrupt_survives_later_wait_failure(monkeypatch,fault,later):
+    events=[]
+    def terminate():
+        events.append('terminate')
+        if len(events)==1:raise fault
+    def is_closed():
+        if later=='wait_error':raise OSError('secondary wait failure')
+        return False
+    owner=SimpleNamespace(terminate=terminate,is_closed=is_closed,
+                          close=lambda:events.append('owner-close'))
+    clock=iter((0,1,2_000_000))
+    monkeypatch.setattr(core.time,'monotonic_ns',lambda:next(clock))
+    monkeypatch.setattr(core.os,'close',lambda fd:events.append(fd))
+    with pytest.raises(type(fault)) as error:core._cleanup(owner,[21,22],1)
+    assert error.value is fault
+    assert events==['terminate','terminate',21,22,'owner-close']
+
+
+@pytest.mark.parametrize('fault',[KeyboardInterrupt(),SystemExit(0)])
+@pytest.mark.parametrize('index',[0,1,2],ids=['stdin','stdout','stderr'])
+def test_interrupted_close_does_not_close_reused_foreign_descriptor(monkeypatch,fault,index):
+    # Simulate a close that finishes before cancellation is delivered, then an
+    # unrelated allocation reusing the number. Cleanup must not own that number.
+    fd=os.open(os.devnull,os.O_RDONLY); replacement=[]; real_close=os.close
+    descriptors=[None,None,None];descriptors[index]=fd
+    owner=SimpleNamespace(poll=lambda:0,terminate=lambda:None,is_closed=lambda:True,close=lambda:None)
+    settings=SimpleNamespace(max_stdout_bytes=1,max_stderr_bytes=1)
+    def close(value):
+        real_close(value)
+        if value==fd:
+            replacement.append(os.open(os.devnull,os.O_RDONLY))
+            assert replacement[0]==fd
+            raise fault
+    try:
+        with monkeypatch.context() as patch:
+            patch.setattr(core.os,'close',close)
+            with pytest.raises(type(fault)) as error:
+                core._drain(owner,descriptors,b'',settings,time.monotonic_ns()+1_000_000_000,None)
+            assert error.value is fault
+        core._cleanup(owner,descriptors,100)
+        assert os.fstat(replacement[0]) is not None
+        assert descriptors==[None,None,None]
+    finally:
+        for value in replacement or [fd]:
+            try:real_close(value)
+            except OSError:pass
